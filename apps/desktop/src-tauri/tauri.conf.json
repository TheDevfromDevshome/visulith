{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visulith",
  "version": "0.0.2",
  "identifier": "dev.visulith.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @visulith/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @visulith/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Visulith Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b0f16",
        "zoomHotkeysEnabled": false,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
